{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.sednaspace.earth" }], "destination": "https://sednaspace.earth/$1", "permanent": true }
  ],
  "headers": [
    { "source": "/demo/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/landing/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
